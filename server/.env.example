# Port the API listens on
PORT=5000

# MongoDB connection string (MongoDB Atlas or local)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/retain?retryWrites=true&w=majority

# Secret used to sign JWTs - use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Allowed frontend origin(s), comma separated
CLIENT_URL=http://localhost:5173

# Admin account created by `npm run seed`
ADMIN_NAME=Retain Admin
ADMIN_EMAIL=admin@retain.app
ADMIN_PASSWORD=Admin@12345
